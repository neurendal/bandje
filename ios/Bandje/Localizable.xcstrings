        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мова розпізнається автоматично. Усе залишається на цьому %@."
          }
        }
      }
    },
    "The main points in two or three sentences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wichtigsten Punkte in zwei oder drei Sätzen."
