    "## Heading, then a line about what goes under it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Überschrift, darunter eine Zeile, was dazugehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Encabezado, y debajo una línea sobre lo que va ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Titre, puis une ligne sur ce qui va dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Titolo, poi una riga su cosa va sotto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Kopje, daaronder een regel over wat erbij hoort."
