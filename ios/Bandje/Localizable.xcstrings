    "Listen to a fragment and type a name. Every label of that speaker changes along." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör dir einen Ausschnitt an und gib einen Namen ein. Jede Beschriftung dieses Sprechers ändert sich mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha un fragmento y escribe un nombre. Todas las etiquetas de ese hablante cambian también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez un extrait et saisissez un nom. Chaque étiquette de cet intervenant change aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta un frammento e scrivi un nome. Ogni etichetta di quel parlante cambia di conseguenza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luister naar een fragment en typ een naam. Elk label van die spreker verandert mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posłuchaj fragmentu i wpisz imię. Każda etykieta tego mówcy zmieni się razem z nim."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça um trecho e digite um nome. Todos os rótulos desse falante mudam junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослушайте фрагмент и введите имя. Все метки этого говорящего изменятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослухайте фрагмент і введіть ім’я. Усі мітки цього мовця зміняться."
