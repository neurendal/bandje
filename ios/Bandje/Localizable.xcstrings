    "Everything on your own device: no tokens, super fast, with who said what, in 25 languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf deinem eigenen Gerät: keine Tokens, superschnell, mit wer was gesagt hat, in 25 Sprachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en tu propio dispositivo: sin tokens, superrápido, con quién dijo qué, en 25 idiomas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout sur votre propre appareil : aucun jeton, ultra-rapide, avec qui a dit quoi, en 25 langues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto sul tuo dispositivo: nessun token, velocissimo, con chi ha detto cosa, in 25 lingue."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op je eigen apparaat: geen tokens, supersnel, met wie wat zei, in 25 talen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko na Twoim urządzeniu: bez tokenów, superszybko, z tym, kto co powiedział, w 25 językach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo no seu próprio dispositivo: sem tokens, superrápido, com quem disse o quê, em 25 idiomas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё на вашем устройстве: без токенов, очень быстро, с тем, кто что сказал, на 25 языках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
