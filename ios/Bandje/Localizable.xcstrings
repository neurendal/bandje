    "The audio system restarted. The recording so far has been saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Audiosystem wurde neu gestartet. Die bisherige Aufnahme ist gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema de audio se ha reiniciado. Se ha guardado lo grabado hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système audio a redémarré. L’enregistrement jusqu’ici a été sauvegardé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema audio si è riavviato. La registrazione fatta finora è stata salvata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het audiosysteem is opnieuw gestart. De opname tot nu toe is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System audio uruchomił się ponownie. Dotychczasowe nagranie zostało zachowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de áudio foi reiniciado. A gravação até agora foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиосистема перезапустилась. Запись до этого момента сохранена."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудіосистему перезапущено. Записане досі збережено."
          }
        }
      }
    },
    "The language is recognised automatically. Everything stays on this %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache wird automatisch erkannt. Alles bleibt auf diesem %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma se reconoce automáticamente. Todo se queda en este %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue est reconnue automatiquement. Tout reste sur cet %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
