        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprzedź, że nagrywasz"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise quando gravar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупредите о записи"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередьте про запис"
          }
        }
      }
    },
    "Tell people you are recording. In some countries, and at work, the law requires it, and sometimes their consent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag den anderen, dass du aufnimmst. In manchen Ländern und bei der Arbeit schreibt das Gesetz das vor, und manchmal auch ihre Zustimmung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa a los demás de que estás grabando. En algunos países, y en el trabajo, la ley lo exige y, a veces, también su consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenez les gens que vous enregistrez. Dans certains pays, et au travail, la loi l’exige, et parfois leur accord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa le persone che stai registrando. In alcuni paesi, e al lavoro, la legge lo richiede, e a volte serve il loro consenso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat mensen weten dat je opneemt. In sommige landen, en op het werk, verplicht de wet dat, en soms hun toestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprzedź innych, że nagrywasz. W niektórych krajach, a także w pracy, wymaga tego prawo, a czasem wymagana jest też ich zgoda."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise as pessoas que você está gravando. Em alguns países, e no trabalho, a lei exige isso e, às vezes, o consentimento delas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждайте людей, что ведёте запись. В некоторых странах, а также на работе, этого требует закон, а иногда и их согласия."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереджайте людей, що ви записуєте. У деяких країнах, а також на роботі, цього вимагає закон, а іноді й їхньої згоди."
          }
        }
      }
    },
