    "0" : {
      "comment" : "A placeholder for the number of matches found.",
      "isCommentAutoGenerated" : true
    },
    "A template is a list of headings (## Heading) with a line under each about what goes there. Keep it short: the model on your %@ has little room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Vorlage ist eine Liste von Überschriften (## Überschrift) mit einer Zeile darunter, was dazugehört. Halte sie kurz: Das Modell auf deinem %@ hat wenig Platz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una plantilla es una lista de encabezados (## Encabezado) con una línea debajo de cada uno sobre lo que va ahí. Que sea breve: el modelo de tu %@ tiene poco espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle est une liste de titres (## Titre) avec, sous chacun, une ligne sur ce qui va dessous. Restez bref : l’IA de votre %@ a peu de place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modello è un elenco di titoli (## Titolo) con sotto ognuno una riga su cosa va lì. Tienilo breve: il modello linguistico sul tuo %@ ha poco spazio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een template is een lijst kopjes (## Kopje) met onder elk een regel over wat erbij hoort. Houd het kort: het model op je %@ heeft weinig ruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szablon to lista nagłówków (## Nagłówek), a pod każdym wiersz o tym, co ma się tam znaleźć. Pisz krótko: model na urządzeniu %@ ma mało miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um modelo é uma lista de títulos (## Título) com uma linha embaixo de cada um sobre o que vai ali. Seja breve: o modelo de linguagem no seu %@ tem pouco espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблон — это список заголовков (## Заголовок), под каждым строка о том, что туда относится. Пишите кратко: у модели на вашем %@ мало места."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблон — це список заголовків (## Заголовок) із рядком під кожним про те, що туди входить. Пишіть коротко: модель на вашому %@ має мало місця."
          }
        }
      }
    },
