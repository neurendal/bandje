        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język jest rozpoznawany automatycznie. Wszystko zostaje na tym urządzeniu %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
