        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha interrotto la trascrizione in background. Tieni aperto Band·je e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS heeft het transcriberen op de achtergrond gestopt. Houd Band·je open en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
