    "5 minutes left. Recordings can be up to 2 hours." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog 5 minuten. Een opname duurt maximaal 2 uur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch 5 Minuten. Eine Aufnahme dauert höchstens 2 Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedan 5 minutos. Una grabación dura como máximo 2 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore 5 minutes. Un enregistrement dure au maximum 2 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora 5 minuti. Una registrazione dura al massimo 2 ore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostało 5 minut. Nagranie może trwać maksymalnie 2 godziny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam 5 minutos. Uma gravação dura no máximo 2 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось 5 минут. Запись длится не более 2 часов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишилося 5 хвилин. Запис триває не більше 2 годин."
          }
        }
      }
    },
    "Band·je can only record with the microphone. Turn it on in Settings › Privacy & Security › Microphone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je kan alleen opnemen met de microfoon. Zet hem aan in Instellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je kann nur mit dem Mikrofon aufnehmen. Schalte es ein unter Einstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je solo puede grabar con el micrófono. Actívalo en Ajustes › Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je ne peut enregistrer qu’avec le micro. Activez-le dans Réglages › Confidentialité et sécurité › Micro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je può registrare solo con il microfono. Attivalo in Impostazioni › Privacy e sicurezza › Microfono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je może nagrywać tylko za pomocą mikrofonu. Włącz go w Ustawienia › Prywatność i ochrona › Mikrofon."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Band·je só pode gravar com o microfone. Ative-o em Ajustes › Privacidade e Segurança › Microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je может записывать только с помощью микрофона. Включите его в Настройки › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band·je може записувати лише через мікрофон. Увімкніть його в Параметри › Приватність і безпека › Мікрофон."
          }
