    "Let others know you're recording. In some countries and at work, this is required." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat anderen weten dat je opneemt. In sommige landen en op het werk is dat verplicht."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag den anderen, dass du aufnimmst. In manchen Ländern und bei der Arbeit ist das Pflicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diles a los demás que estás grabando. En algunos países y en el trabajo es obligatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenez les autres que vous enregistrez. Dans certains pays et au travail, c’est obligatoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai sapere agli altri che stai registrando. In alcuni paesi e al lavoro è obbligatorio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz innym, że nagrywasz. W niektórych krajach i w pracy jest to obowiązkowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise as outras pessoas que você está gravando. Em alguns países e no trabalho, isso é obrigatório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщите другим, что вы ведёте запись. В некоторых странах и на работе это обязательно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомте інших, що ви ведете запис. У деяких країнах і на роботі це обов’язково."
          }
        }
      }
    },
